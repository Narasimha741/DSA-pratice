def fact(n,i=1,c=0):
    if i==n:
        c+=1
        return c
    if n%i==0:
        return fact(n,i+1,c+1)
    return fact(n,i+1,c)

n=int(input("enter number: "))

if fact(n)==2:
    print("prime")
else:
    print("not prime")    


